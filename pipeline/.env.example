# pipeline/.env — API keys for Python pipeline scripts
# Copy this file: cp pipeline/.env.example pipeline/.env
# Fill in your real keys. pipeline/.env is gitignored (never committed).

# ─── Ray Flash 2 (Luma AI) ────────────────────────────────────────────────────
# Get at: https://lumalabs.ai → Dashboard → API Keys
# Same key works for both Dream Machine (old) and Ray Flash 2 (new)
RAY_API_KEY=your_luma_api_key_here

# ─── Cloudflare Stream ────────────────────────────────────────────────────────
# Account ID: Cloudflare Dashboard → right sidebar (Overview page)
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# API Token: Cloudflare Dashboard → My Profile → API Tokens
# → Create Token → Stream: Edit (scoped to your account)
CF_STREAM_TOKEN=your_cloudflare_stream_api_token_here
