# pipeline/.env — API keys for Python pipeline scripts
# Copy this file to pipeline/.env and fill in your keys.
# This file is safe to commit. pipeline/.env is gitignored.

# Luma AI Dream Machine
# Get at: https://lumalabs.ai → Dashboard → API Keys
LUMA_API_KEY=your_luma_api_key_here

# Cloudflare Stream
# Get at: Cloudflare Dashboard → My Profile → API Tokens → Create Token → Stream:Edit
# Account ID: Cloudflare Dashboard → right sidebar
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_STREAM_TOKEN=your_cloudflare_stream_api_token_here
